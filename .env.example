# Data provider: 'indexeddb' (demonstração, padrão) | 'mock' (memória, testes) | 'api' (produção)
VITE_DATA_PROVIDER=indexeddb

# Base URL da API — usado apenas quando VITE_DATA_PROVIDER=api
VITE_API_BASE_URL=https://api.exemplo.com/v1

# Seletor de perfil de demonstração. Deve ficar atrás de flag e não existir em produção.
VITE_ENABLE_PROFILE_SWITCHER=true
