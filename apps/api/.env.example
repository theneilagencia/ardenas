# Arden.AS API — variáveis de ambiente (ARDEN-BE-001).
# Copie para apps/api/.env e ajuste. NUNCA commitar .env com segredos reais.

# Ambiente: development | test | production
NODE_ENV=development

# Porta HTTP da API
PORT=3000

# Conexão PostgreSQL (obrigatória). Local de exemplo:
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/arden_dev?schema=public

# Nível de log Pino: fatal|error|warn|info|debug|trace
LOG_LEVEL=info

# Versão da aplicação (exposta em /health e /api/v1/meta)
APP_VERSION=0.1.0

# CORS: allowlist separada por vírgula. Em production NÃO usar "*".
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Prefixo da API
API_PREFIX=/api/v1

# Servir Swagger/OpenAPI em /api/docs (desabilite em production se desejar)
ENABLE_SWAGGER=true

# SHA do commit (opcional; exposto em /api/v1/meta quando presente)
GIT_SHA=

# ── Autenticação (ARDEN-BE-002) ───────────────────────────────────────────────
# Provider de identidade: supabase | fake
#   - supabase: verificação criptográfica de JWT (JWKS). Exige as variáveis abaixo.
#   - fake: SOMENTE desenvolvimento/testes (proibido em production).
AUTH_PROVIDER=fake

# Supabase (necessário quando AUTH_PROVIDER=supabase). NUNCA commitar valores reais.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# JWKS do projeto Supabase (verificação de assinatura):
SUPABASE_JWKS_URL=
# Emissor esperado (iss) e audiência (aud) do token:
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=
# Tolerância de relógio (segundos) para exp/nbf:
AUTH_CLOCK_TOLERANCE_SECONDS=5

# ── Cofre de credenciais (ARDEN-BE-006.4) ─────────────────────────────────────
# Provider do cofre: app-aes-gcm | fake
#   - app-aes-gcm: criptografia AES-256-GCM na aplicação (produção).
#   - fake: SOMENTE testes unitários (proibido em production).
CONNECTOR_VAULT_PROVIDER=app-aes-gcm
# Master key AES-256 em Base64 = EXATAMENTE 32 bytes. NUNCA commitar valor real.
# Gere com:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Obrigatória em production; sem default; strings curtas são rejeitadas no startup.
CONNECTOR_MASTER_KEY=
# Versão da chave corrente (persistida nos metadados da credencial).
CONNECTOR_KEY_VERSION=v1
# Keyring opcional para decifrar versões antigas após rotação de master key:
#   JSON { "<version>": "<base64-32-bytes>" }. Vazio = só a chave corrente.
CONNECTOR_KEYRING_JSON=
