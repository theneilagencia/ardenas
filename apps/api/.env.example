# Arden.AS API — variáveis de ambiente (ARDEN-BE-001).
# Copie para apps/api/.env e ajuste. NUNCA commitar .env com segredos reais.

# Ambiente: development | test | production
NODE_ENV=development

# Porta HTTP da API
PORT=3000

# Conexão PostgreSQL (obrigatória). Local de exemplo:
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/arden_dev?schema=public

# Nível de log Pino: fatal|error|warn|info|debug|trace
LOG_LEVEL=info

# Versão da aplicação (exposta em /health e /api/v1/meta)
APP_VERSION=0.1.0

# CORS: allowlist separada por vírgula. Em production NÃO usar "*".
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Prefixo da API
API_PREFIX=/api/v1

# Servir Swagger/OpenAPI em /api/docs (desabilite em production se desejar)
ENABLE_SWAGGER=true

# SHA do commit (opcional; exposto em /api/v1/meta quando presente)
GIT_SHA=
