{
  "name": "@arden/api",
  "version": "0.1.0",
  "private": true,
  "description": "Arden.AS — fundação do backend (NestJS + Fastify + Prisma). ARDEN-BE-001.",
  "type": "commonjs",
  "main": "dist/main.js",
  "scripts": {
    "dev": "npm -w @arden/contracts run build && node --watch -r ts-node/register -r tsconfig-paths/register src/main.ts",
    "build": "tsc -b tsconfig.build.json",
    "start": "node dist/main.js",
    "start:worker": "ARDEN_WORKER=1 node dist/worker.js",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\" --max-warnings=0",
    "test": "vitest run src",
    "test:integration": "vitest run test",
    "test:execution": "vitest run src/executions",
    "test:execution:integration": "vitest run test/execution-flow.integration.spec.ts test/execution-critical.integration.spec.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:reset:test": "prisma migrate reset --force --skip-seed",
    "db:seed": "ARDEN_CLI=seed vite-node prisma/seed.ts",
    "bootstrap:organization": "ARDEN_CLI=bootstrap vite-node prisma/bootstrap-organization.ts"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.115.0",
    "@arden/contracts": "*",
    "@fastify/helmet": "^11.1.1",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-fastify": "^10.4.15",
    "@nestjs/terminus": "^10.2.3",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^5.22.0",
    "fastify": "4.28.1",
    "jose": "^5.10.0",
    "js-yaml": "^4.1.0",
    "nestjs-pino": "^4.1.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^11.0.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.15",
    "@swc/core": "^1.10.7",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.17.0",
    "pino-pretty": "^13.0.0",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "unplugin-swc": "^1.5.1",
    "vitest": "^3.2.7"
  }
}
